---
import { sortedPosts } from '@/utils/helpers'
import { supportedLangCodes } from '@/i18n/utils'
import type { MarkdownInstance } from 'astro'
import type { JobFrontmatter } from '@/types'

export async function getStaticPaths() {
  const jobs =  sortedPosts(import.meta.glob<MarkdownInstance<JobFrontmatter>>('../../../jobs/*.{md,mdx}', { eager: true }));
  const result = supportedLangCodes.flatMap((langCode) => {
    return jobs.map((job) => {
      return {
        params: {
          locale: langCode,
          job: job.frontmatter.permalink.slice(1).slice(0, -1)
        },
        props: job
      }
    })
  })

  return result
}

type Props = MarkdownInstance<JobFrontmatter>

const { Content } = Astro.props
---

<Content />

<script>
document.addEventListener("DOMContentLoaded", function() {
  window.scrollTo({
      top: 900,
      behavior: "smooth"
  });
});
</script>
